XN1 mid B VSS VSS sky130_fd_pr__nfet_01v8 w=1.68 l=0.15
.ends nand2x2

* nand2x4
.subckt nand2x4 A B Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=4.00 l=0.15
XP1 Y B VDD VDD sky130_fd_pr__pfet_01v8 w=4.00 l=0.15
XN0 Y   A mid VSS sky130_fd_pr__nfet_01v8 w=3.36 l=0.15
