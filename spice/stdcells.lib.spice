XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=1.00u l=0.15u
XP1 Y B VDD VDD sky130_fd_pr__pfet_01v8 w=1.00u l=0.15u
XN0 Y   A mid VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
XN1 mid B VSS VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
.ends nand2x1

