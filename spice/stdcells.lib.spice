XN1 Y B VSS VSS sky130_fd_pr__nfet_01v8 w=1.68 l=0.15
.ends nor2x4

* maj3x1
* PUN: (A+B).(B+C).(A+C) - worst case 3 PMOS in series -> W=3.00u
* PDN: AB+BC+AC          - worst case 2 NMOS in series -> W=0.84u
.subckt maj3x1 A B C Y VDD VSS
* PUN
XP0 pmid0 A VDD  VDD sky130_fd_pr__pfet_01v8 w=3.00 l=0.15
XP1 pmid0 B VDD  VDD sky130_fd_pr__pfet_01v8 w=3.00 l=0.15
XP2 pmid1 B pmid0 VDD sky130_fd_pr__pfet_01v8 w=3.00 l=0.15
XP3 pmid1 C pmid0 VDD sky130_fd_pr__pfet_01v8 w=3.00 l=0.15
XP4 Y    A pmid1 VDD sky130_fd_pr__pfet_01v8 w=3.00 l=0.15
XP5 Y    C pmid1 VDD sky130_fd_pr__pfet_01v8 w=3.00 l=0.15
* PDN
XN0 Y    A nmid0 VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
XN1 nmid0 B VSS  VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
XN2 Y    B nmid1 VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
XN3 nmid1 C VSS  VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
XN4 Y    A nmid2 VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
XN5 nmid2 C VSS  VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
.ends maj3x1

