* nor2x1
.subckt nor2x1 A B Y VDD VSS
XP0 mid A VDD VDD sky130_fd_pr__pfet_01v8 w=2.00 l=0.15
XP1 Y   B mid VDD sky130_fd_pr__pfet_01v8 w=2.00 l=0.15
XN0 Y A VSS VSS sky130_fd_pr__nfet_01v8 w=0.42 l=0.15
XN1 Y B VSS VSS sky130_fd_pr__nfet_01v8 w=0.42 l=0.15
