XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=4.00 l=0.15
XN0 Y A VSS VSS sky130_fd_pr__nfet_01v8 w=1.68 l=0.15
.ends invx4

* invx8
.subckt invx8 A Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=8.00 l=0.15
