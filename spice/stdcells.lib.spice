XP5 Y    C mid1 VDD sky130_fd_pr__pfet_01v8 w=3.00u l=0.15u
* PDN
XN0 Y    A mid0 VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
XN1 mid0 B VSS  VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
XN2 Y    B mid1 VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
XN3 mid1 C VSS  VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
XN4 Y    A mid2 VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
XN5 mid2 C VSS  VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
.ends maj3x1

