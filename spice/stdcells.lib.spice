.ends nand2x2

* nand2x4
.subckt nand2x4 A B Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=4.00u l=0.15u
XP1 Y B VDD VDD sky130_fd_pr__pfet_01v8 w=4.00u l=0.15u
