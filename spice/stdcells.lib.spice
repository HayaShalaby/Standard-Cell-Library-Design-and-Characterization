* ============================================================================
* SKY130 standard cell library - 13 subcircuits:
*   invx1 invx2 invx4 invx8
*   nand2x1 nand2x2 nand2x4
*   nor2x1 nor2x2 nor2x4
*   maj3x1 maj3x2 maj3x4
* ============================================================================

* invx1
.subckt invx1 A Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=1.00u l=0.15u
XN0 Y A VSS VSS sky130_fd_pr__nfet_01v8 w=0.42u l=0.15u
.ends invx1

* invx2
.subckt invx2 A Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=2.00u l=0.15u
XN0 Y A VSS VSS sky130_fd_pr__nfet_01v8 w=0.84u l=0.15u
.ends invx2

* invx4
.subckt invx4 A Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=4.00u l=0.15u
XN0 Y A VSS VSS sky130_fd_pr__nfet_01v8 w=1.68u l=0.15u
.ends invx4

* invx8
.subckt invx8 A Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=8.00u l=0.15u
