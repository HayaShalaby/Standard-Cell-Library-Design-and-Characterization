.ends invx8

* nand2x1
.subckt nand2x1 A B Y VDD VSS
XP0 Y A VDD VDD sky130_fd_pr__pfet_01v8 w=1.00 l=0.15
XP1 Y B VDD VDD sky130_fd_pr__pfet_01v8 w=1.00 l=0.15
XN0 Y   A mid VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
XN1 mid B VSS VSS sky130_fd_pr__nfet_01v8 w=0.84 l=0.15
.ends nand2x1

